# Copy this file to `.env` (next to this file, never commit it) and fill in the values. Names only here, no secrets.
# Precedence: the process environment > this `.env` > the second file in each class's pipeline.config.json `envFiles`
# (a path on the original author's machine: a clone can ignore it, `node cli.mjs doctor` shows it as MISSING).
# `node cli.mjs doctor` (in a class folder) prints each value masked, so you can see what is set.

# the Postgres database that holds the learning plans (lp2_* tables); the machine's IP must be allowed on it
DATABASE_URL=

# where `publish --upload` writes (Google Cloud Storage bucket, the CDN host that serves it, the origin host)
ORCH_GCS_BUCKET=
ORCH_CDN_HOST=
ORCH_ORIGIN_HOST=
ORCH_GCS_CACHE_CONTROL=
ORCH_UPLOAD_API=

# the object pictures of the image agent (`node cli.mjs images make`): Gemini
GEMINI_API_KEY=

# which lp tables to read: `lpv2` by default (pipeline.config.json `lpDest`)
LP_DEST=
